// Change this to the digitizing year to get a Sentinel-2 mosiac for it.
var year = 2025;
// Run the export tasks
var run_export = true;
/**
 * Function to mask clouds using the Sentinel-2 QA band
 * @param {ee.Image} image Sentinel-2 image
 * @return {ee.Image} cloud masked Sentinel-2 image
 */
function maskS2clouds(image) {
  var qa = image.select('QA60');

  // Bits 10 and 11 are clouds and cirrus, respectively.
  var cloudBitMask = 1 << 10;
  var cirrusBitMask = 1 << 11;

  // Both flags should be set to zero, indicating clear conditions.
  var mask = qa.bitwiseAnd(cloudBitMask).eq(0)
      .and(qa.bitwiseAnd(cirrusBitMask).eq(0));

  return image.updateMask(mask).divide(10000);
}

// Map the function over a month of data and take the median.
// Load Sentinel-2 TOA reflectance data (adjusted for processing changes
// that occurred after 2022-01-25).
var dataset = ee.ImageCollection('COPERNICUS/S2_HARMONIZED')
                  .filterDate(year + '-07-01', year + '-08-31')
                  .filterBounds(ee.Geometry.BBox(10, 76, 30, 81))
                  // Pre-filter to get less cloudy granules.
                  .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 20))
                  .map(maskS2clouds);

var rgbVis = {
  min: -2,
  max: 0,
  bands: ['B4', 'B3', 'B2'],
};

//Map.setCenter(15, 78, 5);
Map.addLayer(dataset.mosaic().log10(), rgbVis, 'RGB');


if (run_export) {
  // ============================================================
  // CREVASSE TRAINING LABEL EXPORT
  // Merges every poly_pos_<year>/poly_neg_<year> Import in this script into
  // one tagged FeatureCollection and exports it as:
  //   1. a GEE asset, for svalbard_crevasse_detection.js to train on, and
  //   2. a Drive GeoJSON, for offline spatial/temporal coverage auditing
  //      (see src/label_audit.py in the main repo).
  //
  // Run this from whichever GEE script currently holds the poly_pos_<year>/
  // poly_neg_<year> Imports. Edit LABEL_YEARS below to match exactly the
  // years actually present as Imports here -- an entry referencing a var that
  // doesn't exist will fail to load the script.
  // ============================================================

  var LABELS_ASSET_ID = 'users/erikmann/crevasse_training_labels';
  var DRIVE_FOLDER = 'crevasse_maps';
  var DRIVE_FILENAME = 'crevasse_training_labels';

  // Add/remove entries to match the poly_pos_<year>/poly_neg_<year> Imports
  // actually present in this script's Imports panel. `year` is a plain
  // client-side number here (not an ee.Number), so it is kept as a real
  // numeric property server-side.
  var LABEL_YEARS = [
    { year: 2017, neg: poly_neg_2017, pos: poly_pos_2017 },
    { year: 2019, neg: poly_neg_2019, pos: poly_pos_2019 },
    { year: 2021, neg: poly_neg_2021, pos: poly_pos_2021 },
    { year: 2023, neg: poly_neg_2023, pos: poly_pos_2023 },
    { year: 2024, neg: poly_neg_2024, pos: poly_pos_2024 },
    { year: 2025, neg: poly_neg_2025, pos: poly_pos_2025 }
  ];

  // Tags every feature with year/crevassed/polyg_id and drops digitizing-tool
  // bookkeeping properties (e.g. system:index survives as part of polyg_id,
  // not as a separate column) so the export schema is stable regardless of
  // how the source Import was drawn.
  function taggedCollection(regions, year, crevassed) {
    var classLabel = crevassed ? 'pos' : 'neg';
    // year/classLabel are plain client-side values, so build the id prefix
    // with ordinary JS string concatenation; only f.get('system:index') is a
    // server-side value and needs ee.String().cat(). (ee.String() on a plain
    // JS number does not coerce it the way you'd expect -- that was the
    // "couldn't convert the id part to a string" error.)
    var idPrefix = year + '_' + classLabel + '_';
    return ee.FeatureCollection(regions).map(function(f) {
      var polygId = ee.String(idPrefix).cat(ee.String(f.get('system:index')));
      return ee.Feature(f.geometry()).set({
        year: year,
        crevassed: crevassed,
        polyg_id: polygId
      });
    });
  }

  var allLabels = LABEL_YEARS.reduce(function(merged, entry) {
    return merged
      .merge(taggedCollection(entry.neg, entry.year, false))
      .merge(taggedCollection(entry.pos, entry.year, true));
  }, ee.FeatureCollection([]));

  print('Total tagged labels', allLabels.size());
  print('Example tagged label', allLabels.first());

  Export.table.toAsset({
    collection: allLabels,
    description: 'crevasse_training_labels_to_asset',
    assetId: LABELS_ASSET_ID,
    overwrite: true,
  });

  Export.table.toDrive({
    collection: allLabels,
    description: 'crevasse_training_labels_to_drive',
    folder: DRIVE_FOLDER,
    fileNamePrefix: DRIVE_FILENAME,
    fileFormat: 'GeoJSON'
  });

